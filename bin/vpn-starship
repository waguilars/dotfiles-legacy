#!/usr/bin/env bash
# Starship: candado + perfil + IP. Uso: vpn-starship | vpn-starship --when
set -euo pipefail

vpn_tun_iface() {
  ip -o link show 2>/dev/null | awk -F': ' '
    $2 ~ /^(tun|tap)[0-9]*$/ && $0 ~ /UP/ { print $2; exit }
  '
}

iface=$(vpn_tun_iface || true)
[[ -n $iface ]] || exit 1

if [[ ${1:-} == --when ]]; then
  exit 0
fi

ip=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}' | head -1 | cut -d/ -f1)

profile=
pid=$(pgrep -nx openvpn 2>/dev/null || true)
if [[ -n $pid ]]; then
  args=$(ps -p "$pid" -o args= 2>/dev/null || true)
  config=$(sed -n 's/.*--config[[:space:]]*\([^[:space:]]*\).*/\1/p' <<<"$args")
  [[ -n $config ]] && profile=$(basename "$config" .ovpn)
fi

printf '󰌾'
[[ -n $profile ]] && printf ' %s' "$profile"
[[ -n $ip ]] && printf ' %s' "$ip"
