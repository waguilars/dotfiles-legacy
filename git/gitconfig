[user]
	name = Wilson Aguilar
	email = waguilar@montran.com

[include]
	path = $HOME/.dotfiles/git/gitconfig.local

[commit]
	gpgsign = false

[init]
	defaultBranch = main

[credential]
	helper = store

[core]
	autocrlf = input
	eol = lf
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[merge]
	conflictStyle = zdiff3

[alias]
	work = !git config --global user.email "$(git config -f "$HOME/.dotfiles/git/gitconfig.local" --get author.work)"
	personal = !git config --global user.email "$(git config -f "$HOME/.dotfiles/git/gitconfig.local" --get author.personal)"
	clean-branches = !~/.dotfiles/bin/git-clean-branches
